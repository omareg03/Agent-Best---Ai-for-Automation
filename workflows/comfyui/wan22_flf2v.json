{
  "_comment": "Wan 2.2 14B FLF2V -- first-last-frame-to-video. PRIMARY production graph. Tokens (__TOKEN__) are substituted by scripts/video_pipeline/engines/comfy.py. Node class names mirror the ComfyUI native 'Wan2.2 14B FLF2V' template; run `cli comfy validate --graph wan22_flf2v` against a live server before spending GPU time. VRAM: 16-24 GB with the fp8/GGUF experts; 40 GB+ full precision. Output: 81 frames @ 16 fps.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan_2.1_vae.safetensors" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "__START_IMAGE__" },
    "_note": "First frame. In production this is the previous clip's extracted last clean frame."
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "__END_IMAGE__" },
    "_note": "Last frame. The target composition for this shot."
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["3", 0] }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["3", 0] }
  },
  "9": {
    "class_type": "WanFirstLastFrameToVideo",
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["4", 0],
      "start_image": ["5", 0],
      "end_image": ["6", 0],
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "length": "__FRAMES__",
      "batch_size": 1
    },
    "_note": "Native FLF2V conditioning -- this node is why seams do not exist by construction."
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 8.0 }
  },
  "11": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["2", 0], "shift": 8.0 }
  },
  "12": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["10", 0],
      "add_noise": "enable",
      "noise_seed": "__SEED__",
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "start_at_step": 0,
      "end_at_step": 10,
      "return_with_leftover_noise": "enable"
    },
    "_note": "High-noise expert: composition and large motion in the first half of the schedule."
  },
  "13": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["11", 0],
      "add_noise": "disable",
      "noise_seed": "__SEED__",
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["12", 0],
      "start_at_step": 10,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    },
    "_note": "Low-noise expert: detail and texture in the second half (Wan 2.2 MoE two-stage sampling)."
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["13", 0], "vae": ["4", 0] }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["14", 0], "fps": "__FPS__" }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["15", 0],
      "filename_prefix": "pipeline/__PREFIX__",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
