# Copy to .env and fill in what you actually use. Never commit .env.
# Every variable is optional: the pipeline runs fully offline with `--engine mock`.

# ---------------------------------------------------------------------------
# Hosted image generation (Stage A -- keyframes)
# No free tier exists for Gemini image output. See registry/tools.json.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Nano Banana 2.1 (GA 2026-10-06). Do NOT use gemini-3.1-flash-image: retired 2026-10-29.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Hosted video fallback (paid, ~$0.10/s at 720p)
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# ---------------------------------------------------------------------------
# Open-weight video generation (Stage B -- the primary path)
# ---------------------------------------------------------------------------
COMFYUI_URL=http://127.0.0.1:8188

# ---------------------------------------------------------------------------
# Narration (Stage C)
# Kokoro-82M served by Kokoro-FastAPI. Apache-2.0, commercial-safe, CPU-capable.
#   docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
# ---------------------------------------------------------------------------
KOKORO_TTS_URL=http://127.0.0.1:8880
PIPELINE_TTS_VOICE=af_heart
# Only if you accept the ToU risk; REQUIRES >=7.3.1 (older builds 403).
PIPELINE_EDGE_VOICE=en-US-AriaNeural

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
# Point at a full ffmpeg (with libass + ffprobe). Empty = auto-detect.
FFMPEG_BIN=
FFPROBE_BIN=
# Where `init` writes new projects. Default: <repo>/projects
PIPELINE_PROJECTS_DIR=
# Used by the registry refresh to raise the GitHub API limit (60/h -> 5000/h)
GITHUB_TOKEN=
# Optional alert webhook for the n8n staleness workflow
ALERT_WEBHOOK_URL=
