{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/video-package-storyboard.schema.json",
  "title": "Abacus Studio YouTube storyboard package",
  "description": "Strict 12-block vertical video package schema used before media generation and assembly.",
  "type": "object",
  "required": [
    "title", "slug", "channel", "format", "target_duration_seconds", "aspect_ratio",
    "fps_master", "audio_master", "visual_lock", "reference_sheet_prompt", "source_citations", "blocks"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "requested_title": {"type": "string"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "channel": {"type": "string", "minLength": 1},
    "format": {"type": "string", "enum": ["YouTube Short", "YouTube long-form"]},
    "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "aspect_ratio": {"type": "string", "enum": ["9:16", "16:9"]},
    "fps_master": {"type": "integer", "enum": [30, 60]},
    "audio_master": {"type": "boolean"},
    "visual_lock": {"type": "string", "minLength": 20},
    "reference_sheet_prompt": {"type": "string", "minLength": 30},
    "important_factual_note": {"type": "string"},
    "source_citations": {"$ref": "#/$defs/citations"},
    "blocks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uri"}
    },
    "block": {
      "type": "object",
      "required": [
        "id", "duration_target_seconds", "narration", "visual_prompt", "first_frame_prompt",
        "last_frame_prompt", "motion_prompt", "overlay_title", "overlay_detail", "location",
        "timeline", "audio", "clip", "seed", "model_version", "status", "source_notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^block_[0-9]{2}_[a-z0-9_-]+$"},
        "duration_target_seconds": {"type": "number", "exclusiveMinimum": 0},
        "narration": {"type": "string", "minLength": 1},
        "visual_prompt": {"type": "string", "minLength": 1, "maxLength": 600},
        "first_frame_prompt": {"type": "string", "minLength": 80},
        "last_frame_prompt": {"type": "string", "minLength": 80},
        "motion_prompt": {"type": "string", "minLength": 1},
        "overlay_title": {"type": "string"},
        "overlay_detail": {"type": "string"},
        "coordinates": {"type": "string"},
        "location": {"type": "string", "minLength": 1},
        "timeline": {"type": "string"},
        "elevation_m": {"type": ["number", "null"]},
        "audio": {"type": "string", "pattern": "\\.wav$"},
        "clip": {"type": "string", "pattern": "\\.mp4$"},
        "seed": {"type": "integer"},
        "model_version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["planned", "keyframed", "clipped", "failed"]},
        "source_notes": {"type": "string"},
        "source_citations": {"$ref": "#/$defs/citations"}
      },
      "additionalProperties": true
    }
  }
}
