{
  "name": "00 - AI Tool Registry (24h refresh + staleness gate)",
  "nodes": [
    {
      "parameters": {
        "content": "## AI Tool Registry — 24 h refresh\n\nRuns `cli registry refresh --github` then `cli registry check`.\n\n**Design note:** the script does not invent pricing or licences. It refreshes **liveness** (stars, last push, archived) and **cross-checks the curated licence** against GitHub. `staleness` fails the workflow when a primary tool has gone 30 days without human re-verification — that is the enforcement mechanism for the zero-stale-knowledge rule.\n\nn8n 3.0 note: this uses `scheduleTrigger` + `code` + `executeCommand` (Function/Cron nodes are removed in 3.x).",
        "height": 320,
        "width": 420,
        "color": 5
      },
      "id": "note-registry",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-620, 80]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] }
      },
      "id": "schedule",
      "name": "Every 24 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-160, 200]
    },
    {
      "parameters": {
        "command": "cd {{$env.PIPELINE_REPO}} && python3 -m scripts.video_pipeline.cli registry refresh --github --source n8n"
      },
      "id": "refresh",
      "name": "Refresh registry (liveness + licence)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [80, 200],
      "notes": "Set PIPELINE_REPO and GITHUB_TOKEN in the n8n container environment."
    },
    {
      "parameters": {
        "command": "cd {{$env.PIPELINE_REPO}} && python3 -m scripts.video_pipeline.cli registry check"
      },
      "id": "gate",
      "name": "Staleness gate",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [320, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Summarise the two command outputs into one status object.\nconst items = $input.all();\nconst gateOutput = items[items.length - 1].json.stdout || '';\nconst pass = gateOutput.includes('PASS');\nreturn [{\n  json: {\n    pass,\n    gate: gateOutput.trim().split('\\n').slice(-6).join('\\n'),\n    checkedAt: new Date().toISOString(),\n    action: pass ? 'none' : 're-verify stale tools in registry/tools.json, then commit'\n  }\n}];"
      },
      "id": "summarise",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "stale",
              "leftValue": "={{ $json.pass }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-stale",
      "name": "Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "=⚠️ AI tool registry needs re-verification\n\n{{ $json.gate }}" }
          ]
        },
        "options": {}
      },
      "id": "alert",
      "name": "Alert (Slack/Discord webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 120],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 24 hours": { "main": [[{ "node": "Refresh registry (liveness + licence)", "type": "main", "index": 0 }]] },
    "Refresh registry (liveness + licence)": { "main": [[{ "node": "Staleness gate", "type": "main", "index": 0 }]] },
    "Staleness gate": { "main": [[{ "node": "Summarise", "type": "main", "index": 0 }]] },
    "Summarise": { "main": [[{ "node": "Stale?", "type": "main", "index": 0 }]] },
    "Stale?": { "main": [[{ "node": "Alert (Slack/Discord webhook)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "staticData": null,
  "pinData": {},
  "versionId": 1,
  "meta": {
    "instanceId": "self-hosted",
    "templateCredsSetupCompleted": false,
    "description": "24-hour AI tool registry refresh with a hard staleness gate. Part of Agent-Best---Ai-for-Automation."
  },
  "tags": [{ "name": "media-pipeline" }, { "name": "registry" }]
}
