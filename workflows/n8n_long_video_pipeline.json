        "jsCode": "const body = $json.body ?? $json;\nconst slug = String(body.project_slug ?? '');\nconst allowed = new Set(['koh-chang-ghost-ship', 'flannan-coat', 'example']);\nif (!/^[a-z0-9][a-z0-9-]{1,63}$/.test(slug) || !allowed.has(slug)) throw new Error('project_slug is not allowlisted');\nconst engine = String(body.engine ?? 'mock');\nif (!['mock', 'comfy', 'wan22_flf2v', 'wan22_ti2v_5b'].includes(engine)) throw new Error('engine is not allowlisted');\nreturn [{json: {project_slug: slug, engine, resume: body.resume !== false, dry_run: body.dry_run === true, request_id: String(body.request_id ?? '').slice(0, 96)}}];"
      },
